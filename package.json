{
  "name": "turtle-editor-viewer",
  "version": "2.0.0",
  "type": "module",
  "description": "A modern React + TypeScript RDF/Turtle editor and visualizer",
  "scripts": {
    "predev": "node scripts/setup-monaco.mjs",
    "dev": "vite",
    "prebuild": "node scripts/setup-monaco.mjs",
    "build": "tsc && vite build",
    "setup:monaco": "node scripts/setup-monaco.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 73",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@comunica/query-sparql": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@rdfjs/parser-jsonld": "^2.1.3",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "buffer": "^6.0.3",
    "file-saver": "^2.0.5",
    "hylar-core": "^1.2.2",
    "monaco-editor": "^0.56.0",
    "n3": "^2.2.5",
    "process": "^0.11.10",
    "rdfxml-streaming-parser": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "readable-stream": "^4.7.0",
    "split.js": "^1.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rdfjs/types": "^2.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/n3": "^1.26.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pwin/turtle-editor-viewer"
  },
  "homepage": "https://semantechs.co.uk/turtle-editor-viewer/",
  "keywords": [
    "rdf",
    "turtle",
    "semantic-web",
    "graph-visualization",
    "sparql",
    "typescript",
    "react"
  ],
  "author": "pwin",
  "license": "MIT"
}
