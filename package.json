  "repository": {
    "type": "git",
    "url": "https://github.com/pwin/turtle-editor-viewer"
  },
  "homepage": "https://semantechs.co.uk/turtle-editor-viewer/",
  "keywords": [
    "rdf",
    "turtle",
    "semantic-web",
    "graph-visualization",
    "sparql",
    "typescript",
    "react"
  ],
  "author": "pwin",
  "license": "MIT"
}
