{
  "name": "turtle-editor-viewer",
  "version": "2.0.0",
  "type": "module",
  "description": "A modern React + TypeScript RDF/Turtle editor and visualizer",
  "scripts": {
    "predev": "node scripts/setup-monaco.mjs",
    "dev": "vite",
    "prebuild": "node scripts/setup-monaco.mjs",
    "build": "tsc && vite build",
    "setup:monaco": "node scripts/setup-monaco.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 73",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@comunica/query-sparql": "^5.3.0",
    "@graphy/content.trig.scribe": "^4.3.7",
    "@graphy/content.ttl.scribe": "^4.3.7",
    "@graphy/content.ttl.write": "^4.3.7",
    "@graphy/content.xml.scribe": "^4.3.7",
    "@monaco-editor/react": "^4.7.0",
    "@rdfjs/data-model": "^2.1.2",
    "@rdfjs/dataset": "2.0.2",
    "@rdfjs/formats-common": "^3.1.0",
    "@rdfjs/parser-jsonld": "^2.1.3",
    "@rdfjs/parser-n3": "^2.2.0",
    "@rdfjs/serializer-jsonld": "^2.0.1",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "@rdfjs/serializer-ntriples": "^2.0.1",
    "@rdfjs/to-ntriples": "^3.0.1",
    "@viz-js/viz": "^3.29.0",
    "ace-builds": "^1.44.0",
    "babel-core": "^6.26.3",
    "bluebird": "^3.7.2",
    "body-parser": "^2.3.0",
    "bootstrap": "^5.3.8",
    "browserify": "^17.0.1",
    "clownface": "^2.0.3",
    "commander": "^14.0.3",
    "d3": "^7.9.0",
    "exorcist": "^2.0.0",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "hylar-core": "^1.2.2",
    "jquery": "^3.7.1",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.56.0",
    "n3": "^2.2.5",
    "process": "^0.11.10",
    "pug": "^3.0.4",
    "rdf-ext": "^2.6.0",
    "rdf-validate-shacl": "^0.6.5",
    "rdfa-streaming-parser": "^3.0.2",
    "rdfxml-streaming-parser": "^3.3.0",
    "react": "^19.2.8",
    "react-ace": "^14.1.0",
    "react-dom": "^19.2.8",
    "readable-stream": "^4.7.0",
    "split.js": "^1.6.5",
    "tmp": "^0.2.7",
    "uglify-js": "^3.19.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/file-saver": "^2.0.7",
    "@types/n3": "^1.26.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/split.js": "^1.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "webpack-bundle-analyzer": "^5.3.1",
    "yarn": "^1.22.22"
