import type { RDFQuad, SPARQLQuery } from '@/types'
import {Comunica, QueryEngine} from '@comunica/query-sparql'; 
import {N3} from 'n3';
// const QueryEngine = require('@comunica/query-sparql').QueryEngine;

const myEngine = new QueryEngine();

// Declare global Comunica
declare global {
  interface Window {
    Comunica: {
      newEngine: () => any
    }
    N3: {
      Store: new () => any
    }
  }
}

export interface SPARQLResult {
  head: {
    vars: string[]
  }
  results: {
    bindings: Array<Record<string, {
      type: 'uri' | 'literal' | 'bnode'
      value: string
      datatype?: string
      'xml:lang'?: string
    }>>
  }
}

export interface SPARQLExecutionResult {
  results?: SPARQLResult
  boolean?: boolean
  error?: string
}

/**
 * @deprecated Use useSparqlEngine hook and SparqlUtils instead.
 * This class is maintained for backward compatibility but will be removed in future versions.
 */
export class SPARQLEngine {
  private store: RDFQuad[] = []

  constructor() {
    console.warn('SPARQLEngine is deprecated. Please use useSparqlEngine hook instead.')
  }

  /**
   * Set the RDF store for querying
   */
  setStore(quads: RDFQuad[]): void {
    this.store = quads
  }

  /**
   * Execute a SPARQL query using Comunica engine
   */
  async executeQuery(query: string): Promise<SPARQLExecutionResult> {
    try {
      if (this.store.length === 0) {
        throw new Error('No RDF data loaded. Please parse RDF content first.')
      }

      // Check if Comunica and N3 are available
      if (!window.Comunica || !window.N3) {
        throw new Error('Comunica SPARQL engine or N3 Store not available. Please ensure the libraries are loaded.')
      }

      // Create N3 Store and add quads (following original pattern)
      const queryStore = new window.N3.Store()
      
      // Add all quads to the store
      this.store.forEach(quad => {
        queryStore.addQuad(quad)
      })
      
      if (queryStore.size === 0) {
        throw new Error('No RDF triples available to query.')
      }

      console.log(`Executing SPARQL query against ${queryStore.size} triples`)
      
      // Create Comunica engine (following original pattern)
      const myEngine = window.Comunica.newEngine()
      const config = { sources: [queryStore] }
      
      // Execute query
      const results = await myEngine.query(query, config)
      
      const normalizedQuery = query.trim().toLowerCase()
      
      if (normalizedQuery.includes('select ')) {
        return await this.handleSelectResults(myEngine, results)
      } else if (normalizedQuery.includes('describe ') || normalizedQuery.includes('construct ')) {
        return await this.handleConstructResults(results)
      } else if (normalizedQuery.includes('ask ')) {
        return await this.handleAskResults(results)
      } else {
        throw new Error('Unsupported query type')
      }
      
    } catch (error) {
      console.error('SPARQL execution error:', error)
      return {
        error: `SPARQL execution error: ${error}`
      }
    }
  }

  /**
   * Handle SELECT query results from Comunica
   */
  private async handleSelectResults(engine: any, results: any): Promise<SPARQLExecutionResult> {
    try {
      const { data } = await engine.resultToString(results, 'application/sparql-results+json')
      
      let jsonString = ''
      
      return new Promise((resolve, reject) => {
        data.on('data', (chunk: string) => {
          jsonString += chunk
        })
        
        data.on('end', () => {
          try {
            const parsedResults = JSON.parse(jsonString)
            resolve({
              results: parsedResults
            })
          } catch (parseError) {
            reject(new Error(`Error parsing SPARQL results: ${parseError}`))
          }
        })
        
        data.on('error', (error: any) => {
          reject(new Error(`Error in SPARQL result stream: ${error}`))
        })
      })
    } catch (error) {
      throw new Error(`SELECT result handling error: ${error}`)
    }
  }

  /**
   * Handle CONSTRUCT/DESCRIBE query results
   */
  private async handleConstructResults(results: any): Promise<SPARQLExecutionResult> {
    const triples: any[] = []
    
    return new Promise((resolve, reject) => {
      results.quadStream.on('data', (quad: any) => {
        triples.push({
          subject: quad.subject.value,
          predicate: quad.predicate.value,
          object: quad.object.value,
          graph: quad.graph.value
        })
      })
      
      results.quadStream.on('end', () => {
        // Convert to SELECT-like format for display
        const bindings = triples.map(triple => ({
          s: { type: 'uri' as const, value: triple.subject },
          p: { type: 'uri' as const, value: triple.predicate },
          o: { type: 'uri' as const, value: triple.object }
        }))
        
        resolve({
          results: {
            head: { vars: ['s', 'p', 'o'] },
            results: { bindings }
          }
        })
      })
      
      results.quadStream.on('error', (error: any) => {
        reject(new Error(`CONSTRUCT/DESCRIBE error: ${error}`))
      })
    })
  }

  /**
   * Handle ASK query results
   */
  private async handleAskResults(results: any): Promise<SPARQLExecutionResult> {
    try {
      const hasMatches = await results.booleanResult
      return {
        boolean: hasMatches
      }
    } catch (error) {
      throw new Error(`ASK query error: ${error}`)
    }
  }

